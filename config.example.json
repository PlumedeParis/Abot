{
  "chat": {
    "replyCommand": "/msg {player} {message}",
    "deliveryAnnouncement": "{player} just got a {kit} kit from VoidKits! Get yours: !kit totem / pvp / grief",
    "ignorePattern": "^\\[[^\\]]*discord[^\\]]*\\]",
    "patterns": [],
    "welcome": {
      "message": "order a free kit by doing !kit totem/pvp/grief",
      "cooldownHours": 6
    }
  },
  "limits": {
    "cooldownMinutes": 10,
    "dailyQuota": 10,
    "quotaWindowHours": 24,
    "globalPerMinute": 2,
    "maxQueueSize": 20,
    "maxQueueWaitMinutes": 30,
    "maxAttempts": 2
  },
  "navigation": {
    "autoDetect": true,
    "scanDistance": 6,
    "home": null,
    "returnCommands": [
      "/kill"
    ]
  },
  "delivery": {
    "method": "teleport",
    "commands": [
      "/tpa {player}"
    ],
    "instructions": "Your {kit} kit is ready! Accept my teleport request with /tpaccept within 60 seconds."
  },
  "kits": {
    "totem": {
      "direction": "left",
      "items": [
        {
          "nameRegex": "shulker_box$",
          "count": 1
        }
      ]
    },
    "pvp": {
      "direction": "right",
      "items": [
        {
          "nameRegex": "shulker_box$",
          "count": 1
        }
      ]
    },
    "grief": {
      "direction": "forward",
      "items": [
        {
          "nameRegex": "shulker_box$",
          "count": 1
        }
      ]
    }
  }
}
