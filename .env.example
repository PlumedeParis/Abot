# Copy to .env for local runs (cp .env.example .env). Never commit .env.
# On GitHub Actions these values come from repository Secrets instead.

# --- Minecraft -------------------------------------------------------------
MINECRAFT_HOST=1b1t.cc
MINECRAFT_PORT=25565
# In-game name of the dedicated bot account.
MINECRAFT_USERNAME=
# "offline" for cracked servers that use /reg and /log (AuthMe-style),
# "microsoft" for a premium account on an online-mode server.
MINECRAFT_AUTH=offline
# Password used in "/reg <password> <password>" (first join) and "/log <password>".
MINECRAFT_PASSWORD=
# Optional: protocol version to use. Defaults to server.version in the config (1.21.11).
MINECRAFT_VERSION=1.21.11

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to use /kitbot.
DISCORD_ADMIN_IDS=

# --- Storage ---------------------------------------------------------------
# PostgreSQL connection string. Required on GitHub-hosted runners.
# Leave empty to use SQLite at SQLITE_PATH (good for a VPS or your own PC).
DATABASE_URL=
SQLITE_PATH=./data/kitbot.db

# --- Settings source -------------------------------------------------------
# Path to the non-secret settings file (default: config.json).
KITBOT_CONFIG=config.json
# Alternatively, the whole settings JSON (raw or base64). Takes precedence.
# Useful on GitHub so your stash coordinates are not committed.
KITBOT_CONFIG_JSON=

# --- Docker Compose only ---------------------------------------------------
# Password for the bundled PostgreSQL container (docker-compose.yml).
POSTGRES_PASSWORD=
