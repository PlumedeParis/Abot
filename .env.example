# Copy to .env for local runs (cp .env.example .env). Never commit .env.
# On GitHub Actions these come from repository Secrets; only DISCORD_TOKEN is
# required there, the rest have defaults in .github/workflows/bot.yml.

# --- Minecraft -------------------------------------------------------------
MINECRAFT_HOST=1b1t.cc
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=VoidKits
# "offline" for cracked servers that use /reg and /log (AuthMe-style),
# "microsoft" for a premium account on an online-mode server.
MINECRAFT_AUTH=offline
# Password used in "/reg <password> <password>" (first join) and "/log <password>".
MINECRAFT_PASSWORD=
MINECRAFT_VERSION=1.21.11
# Set to true once you have checked that the server rules allow bots.
KITBOT_BOTS_ALLOWED=false

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
# Optional. Default: the only server the bot is in.
DISCORD_GUILD_ID=
# Optional. Default: #kitbot-logs (created if missing).
DISCORD_LOG_CHANNEL_ID=
# Optional, comma-separated user IDs. Default: the server owner.
DISCORD_ADMIN_IDS=

# --- Storage ---------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use SQLite at SQLITE_PATH.
DATABASE_URL=
SQLITE_PATH=./data/kitbot.db

# --- Settings source -------------------------------------------------------
# Optional settings file (default: config.json if present, else built-in
# defaults with kit chest auto-detection).
KITBOT_CONFIG=
# Alternatively, the whole settings JSON (raw or base64). Takes precedence.
KITBOT_CONFIG_JSON=

# --- Docker Compose only ---------------------------------------------------
# Password for the bundled PostgreSQL container (docker-compose.yml).
POSTGRES_PASSWORD=
